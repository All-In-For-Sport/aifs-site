# All in for Sport - Environment Variables
# Copy this file to .env and fill in your values

# ===========================
# Feature Flags
# ===========================

# Enable/disable the blog/updates section on the homepage
# Set to "true" to show featured updates, "false" to hide
PUBLIC_FEATURE_BLOG=true

# ===========================
# Alchemy API (Optional)
# ===========================

# Alchemy API key for fetching ENS avatars
# Required only if you want to display author ENS avatars
# Sign up at https://www.alchemy.com to get an API key
PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
