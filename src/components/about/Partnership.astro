---
import Tag from '@components/shared/Tag.astro';
---

<section class="page-wrap page-section-padding flex flex-col-reverse items-center gap-16 lg:flex-row">
  <div class="flex w-full justify-center lg:justify-end">
    <div class="relative h-[300px] w-full md:h-[473px] md:w-[484px]">
      <img
        src="/assets/about/partnership.webp"
        class="absolute inset-0 h-full w-full rounded-3xl object-cover object-center"
        alt=""
      />
      <img
        src="/assets/shapes/shape5.png"
        alt=""
        width="81"
        height="83"
        class="absolute -top-10 right-4 h-auto w-16 md:w-24"
      />
      <img
        src="/assets/shapes/shape6.png"
        alt=""
        width="180"
        height="180"
        class="absolute -bottom-16 -left-16 h-auto w-48 md:-bottom-20 md:-left-20 md:w-64"
      />
    </div>
  </div>
  <div class="flex flex-col items-center gap-6 text-center lg:items-start lg:text-left">
    <Tag>Partnership</Tag>
    <h2 class="font-header text-4xl font-bold md:text-5xl">
      Our Partnership with SuperBenefit
    </h2>
    <p class="max-w-md text-white/50 lg:max-w-none">
      AIFS is working closely with
      <a
        href="https://superbenefit.org"
        class="font-bold text-primary"
      >SuperBenefit DAO</a>
      to explore new ways of shifting power in the way capital and
      decision-making flow in communities, designing novel governance
      systems and leveraging blockchain-enabled finance and coordination
      infrastructure to address systemic inequities.
      <br /><br />
      Together, we are working on beta testing our ideas and understanding
      the true value <span class="font-bold text-primary">AIFS</span> can
      provide to its partners, community, and those who have not
      typically had a seat at the table in governance and decision-making.
    </p>
  </div>
</section>
