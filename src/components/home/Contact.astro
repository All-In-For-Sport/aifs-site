      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm font-medium text-white/70">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Michael Jordan"
          required
          class="rounded-xl border border-gray-700 bg-gray-900 px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-primary"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label for="email" class="text-sm font-medium text-white/70">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="michael.jordan@gmail.com"
          required
          class="rounded-xl border border-gray-700 bg-gray-900 px-4 py-3 text-white placeholder-white/30 outline-none transition focus:border-primary"
