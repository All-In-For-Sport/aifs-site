<section id="contactUs" class="page-wrap flex w-full flex-col items-start gap-8 py-24">
  <h2 class="font-header text-4xl font-bold md:text-5xl">Want to get in touch?</h2>
  <div class="flex w-full flex-col gap-8 lg:flex-row lg:items-stretch">
