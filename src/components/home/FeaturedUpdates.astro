---
import { getCollection } from 'astro:content';

const posts = (await getCollection('updates', ({ data }) => data.isFeatured && data.isPublished))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);
---

{posts.length > 0 && (
  <section class="flex flex-col items-center gap-12 py-24">
    <h2 class="font-header text-4xl font-bold md:text-5xl">Updates</h2>
    <div class="m-auto flex max-w-4xl flex-col justify-center gap-8 lg:flex-row">
      {posts.map((post) => (
        <a
          href={`/updates/${post.data.categoryPlural}/${post.id}/`}
          class="group flex flex-col overflow-hidden rounded-2xl bg-gray-900 transition hover:bg-gray-800"
        >
          {post.data.featuredImage && (
            <div class="h-48 w-full overflow-hidden">
              <img
                src={post.data.featuredImage.startsWith('http') ? post.data.featuredImage : `/updates/${post.data.featuredImage}`}
                alt={post.data.featuredImageAltText ?? ''}
                class="h-full w-full object-cover object-[center_15%] transition duration-300 group-hover:scale-105"
              />
            </div>
          )}
          <div class="flex flex-col gap-2 p-6">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">
              {post.data.category}
            </span>
            <h3 class="font-header text-xl font-bold">{post.data.title}</h3>
            <p class="text-sm text-white/50">
              {new Date(post.data.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
