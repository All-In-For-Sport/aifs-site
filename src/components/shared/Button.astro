---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'small';
  href?: string;
  class?: string;
  [key: string]: any;
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 rounded-full font-bold transition';

const variantClasses: Record<string, string> = {
  primary: 'bg-primary px-8 py-3 text-dark-text hover:opacity-90',
  secondary: 'border border-primary px-8 py-3 text-primary hover:bg-primary hover:text-dark-text',
  ghost: 'px-8 py-3 text-white/70 hover:text-white',
  small: 'bg-primary px-4 py-1.5 text-sm text-dark-text hover:opacity-90',
};

const classes = [baseClasses, variantClasses[variant], className].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} {...rest}>
    <slot />
  </button>
)}
