---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      category: string;
      categoryPlural: string;
      featuredImage?: string;
      featuredImageAltText?: string;
    };
  };
}

const { post } = Astro.props;
const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Featured images are stored in public/updates/ — frontmatter only has the filename
const imageSrc = post.data.featuredImage
  ? `/updates/${post.data.featuredImage}`
  : undefined;
---

<a
  href={`/updates/${post.data.categoryPlural}/${post.id}/`}
  class="group flex flex-col overflow-hidden rounded-2xl bg-gray-900 transition hover:bg-gray-800"
>
  {imageSrc && (
    <div class="h-48 w-full overflow-hidden">
      <img
        src={imageSrc}
        alt={post.data.featuredImageAltText ?? ''}
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      />
    </div>
  )}
  <div class="flex flex-col gap-2 p-6">
    <span class="text-xs font-bold uppercase tracking-wider text-primary">
      {post.data.category}
    </span>
    <h3 class="font-header text-xl font-bold">{post.data.title}</h3>
    <p class="text-sm text-white/50">{formattedDate}</p>
  </div>
</a>
