---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/updates/PostCard.astro';
import FilterNavigation from '@components/updates/FilterNavigation.astro';

export async function getStaticPaths() {
  const posts = await getCollection('updates', ({ data }) => data.isPublished);
  const categoryMap = new Map<string, { label: string; pluralSlug: string }>();
  posts.forEach(p => categoryMap.set(p.data.categoryPlural, { label: p.data.category, pluralSlug: p.data.categoryPlural }));

  return [...categoryMap.keys()].map(cat => ({
    params: { category: cat },
  }));
}

const { category } = Astro.params;
const allPosts = (await getCollection('updates', ({ data }) => data.isPublished))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const filteredPosts = allPosts.filter(p => p.data.categoryPlural === category);
const categoryLabel = filteredPosts[0]?.data.category ?? category;

const categories = [...new Map(
  allPosts.map(p => [p.data.categoryPlural, { label: p.data.category, pluralSlug: p.data.categoryPlural }])
).values()];
---

<BaseLayout title={`${categoryLabel} | All in for Sport`} description={`${categoryLabel} updates from All in for Sport`}>
  <section class="page-wrap py-12 lg:py-24">
    <h1 class="mb-8 font-header text-4xl font-bold md:text-5xl">{categoryLabel}</h1>
    <FilterNavigation categories={categories} active={category} />
    <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {filteredPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
